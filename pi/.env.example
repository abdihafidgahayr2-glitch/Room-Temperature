# Copy to .env on the Pi. NEVER commit .env.

# --- Final setup (EC2, TLS) ---
MQTT_HOST=your-domain.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=pi
MQTT_PASSWORD=change-me

# --- Local testing at home (Mosquitto on the Pi itself) ---
# MQTT_HOST=localhost
# MQTT_PORT=1883
# MQTT_TLS=false
# MQTT_USERNAME=
# MQTT_PASSWORD=

MQTT_ROOM=room1
INTERVAL=30
