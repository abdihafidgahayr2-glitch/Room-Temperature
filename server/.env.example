# Copy to .env and fill in. NEVER commit .env to GitHub.

# Long random string: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

# Local testing: sqlite:///./readings.db
# On EC2 (PostgreSQL): postgresql+psycopg://roomapp:PASSWORD@localhost:5432/roommonitor
DATABASE_URL=sqlite:///./readings.db

# Set to true once the site is behind HTTPS (cookie only sent over HTTPS)
HTTPS_ONLY=false

# MQTT broker (Mosquitto on the EC2 instance, TLS on 8883)
MQTT_HOST=your-domain.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=server
MQTT_PASSWORD=change-me
MQTT_ROOM=room1

# Window thresholds in °C (open at/above OPEN_AT, close at/below CLOSE_AT)
OPEN_AT=25.0
CLOSE_AT=23.0
